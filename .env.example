# Copia este archivo a ".env" y rellena SOLO las claves del proveedor que vayas a usar.
# El archivo ".env" está en .gitignore y nunca se sube a GitHub.

# Proveedor por defecto: gemini | openai | anthropic
COMMIT_AI_PROVIDER=gemini

# Opcional: fuerza un modelo concreto
# COMMIT_AI_MODEL=

GEMINI_API_KEY=tu_clave_de_gemini_aqui
OPENAI_API_KEY=tu_clave_de_openai_aqui
ANTHROPIC_API_KEY=tu_clave_de_anthropic_aqui
